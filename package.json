    "groq-sdk": "^1.6.0",
    "gsap": "^3.15.0",
    "highcharts": "^13.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mammoth": "^1.13.0",
